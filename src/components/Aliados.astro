---
const categorias = [
  {
    nombre: 'Pintura',
    descripcion: 'Interior, exterior y acabados especiales',
    icon: 'pintura',
  },
  {
    nombre: 'Cemento y mortero',
    descripcion: 'Obra gris, nivelación y pega',
    icon: 'cemento',
  },
  {
    nombre: 'Enchapes',
    descripcion: 'Piso, pared y porcelanato',
    icon: 'enchape',
  },
  {
    nombre: 'Carpintería',
    descripcion: 'Closets, cocinas y muebles a medida',
    icon: 'carpinteria',
  },
];
---

<section class="aliados">
  <div class="container">
    <div class="section-head reveal aliados-head">
      <span class="eyebrow">MATERIALES</span>
      <h2>Calidad en cada categoría</h2>
      <p>Trabajamos con materiales de marcas reconocidas en el mercado colombiano, con garantía documentada por proveedor.</p>
    </div>
    <div class="aliados-row reveal">
      {categorias.map(c => (
        <div class="aliado-card">
          <div class="aliado-icon" aria-hidden="true">
            {c.icon === 'pintura' && (
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2c-4 5-7 9-7 12.5A7 7 0 0 0 12 21.5a7 7 0 0 0 7-7C19 11 16 7 12 2z" />
              </svg>
            )}
            {c.icon === 'cemento' && (
              <svg viewBox="0 0 24 24" fill="currentColor">
                <rect x="3" y="5" width="8" height="5.5" rx="0.6" />
                <rect x="13" y="5" width="8" height="5.5" rx="0.6" />
                <rect x="8" y="13" width="8" height="5.5" rx="0.6" />
              </svg>
            )}
            {c.icon === 'enchape' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="8" height="8" rx="0.5" />
                <rect x="13" y="3" width="8" height="8" rx="0.5" />
                <rect x="3" y="13" width="8" height="8" rx="0.5" />
                <rect x="13" y="13" width="8" height="8" rx="0.5" />
              </svg>
            )}
            {c.icon === 'carpinteria' && (
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M22.7 19L13.6 9.9c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z" />
              </svg>
            )}
          </div>
          <div class="aliado-name">{c.nombre}</div>
          <div class="aliado-desc">{c.descripcion}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .aliados {
    padding: var(--space-12) 0;
    background: var(--c-bg-soft);
    border-top: 1px solid var(--c-border);
    border-bottom: 1px solid var(--c-border);
  }
  .aliados-head { margin-bottom: var(--space-8); }
  .aliados-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  @media (min-width: 700px) { .aliados-row { grid-template-columns: repeat(4, 1fr); } }
  .aliado-card {
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    text-align: center;
    transition: border-color var(--t-base), transform var(--t-base);
  }
  .aliado-card:hover {
    border-color: var(--c-verde-salvia);
    transform: translateY(-2px);
  }
  .aliado-icon {
    width: 56px; height: 56px;
    margin: 0 auto var(--space-3);
    background: linear-gradient(135deg, var(--c-verde-neutro), var(--c-verde-salvia));
    color: #fff;
    border-radius: var(--radius-md);
    display: flex; align-items: center; justify-content: center;
  }
  .aliado-icon svg { width: 28px; height: 28px; }
  .aliado-name {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--c-text-strong);
    margin-bottom: var(--space-1);
  }
  .aliado-desc {
    font-size: 0.8rem;
    color: var(--c-text-muted);
  }
</style>
